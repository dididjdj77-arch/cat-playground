# Environment templates for S(-2) bootstrap
# Copy one environment block into your runtime .env file.

# local
LOCAL_SUPABASE_URL=http://127.0.0.1:54321
LOCAL_SUPABASE_ANON_KEY=your-local-anon-key
LOCAL_SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key
LOCAL_EXPO_PUBLIC_AUTH_REDIRECT_SCHEME=<local-expo-scheme>
LOCAL_NEXT_PUBLIC_SITE_URL=https://localhost:3000
LOCAL_REVALIDATE_SECRET=<local-server-only-secret>

# staging
STAGING_SUPABASE_URL=https://your-staging-project-ref.supabase.co
STAGING_SUPABASE_ANON_KEY=your-staging-anon-key
STAGING_SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key
STAGING_EXPO_PUBLIC_AUTH_REDIRECT_SCHEME=<staging-expo-scheme>
STAGING_NEXT_PUBLIC_SITE_URL=<staging-next-domain>
STAGING_REVALIDATE_SECRET=<staging-server-only-secret>

# production
PROD_SUPABASE_URL=https://your-prod-project-ref.supabase.co
PROD_SUPABASE_ANON_KEY=your-prod-anon-key
PROD_SUPABASE_SERVICE_ROLE_KEY=your-prod-service-role-key
PROD_EXPO_PUBLIC_AUTH_REDIRECT_SCHEME=<prod-expo-scheme>
PROD_NEXT_PUBLIC_SITE_URL=<prod-next-domain>
PROD_REVALIDATE_SECRET=<prod-server-only-secret>

# active runtime keys (copy from selected environment)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# expo runtime keys (copy from selected environment)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_AUTH_REDIRECT_SCHEME=

# web runtime keys (secret is server-only)
NEXT_PUBLIC_SITE_URL=
REVALIDATE_SECRET=

# Expo OAuth callback rule: <EXPO_PUBLIC_AUTH_REDIRECT_SCHEME>://auth/callback
