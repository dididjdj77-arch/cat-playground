# Environment templates for S(-2) bootstrap
# Copy one environment block into your runtime .env file.

# local
LOCAL_SUPABASE_URL=http://127.0.0.1:54321
LOCAL_SUPABASE_ANON_KEY=your-local-anon-key
LOCAL_SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# staging
STAGING_SUPABASE_URL=https://your-staging-project-ref.supabase.co
STAGING_SUPABASE_ANON_KEY=your-staging-anon-key
STAGING_SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key

# production
PROD_SUPABASE_URL=https://your-prod-project-ref.supabase.co
PROD_SUPABASE_ANON_KEY=your-prod-anon-key
PROD_SUPABASE_SERVICE_ROLE_KEY=your-prod-service-role-key

# active runtime keys (copy from selected environment)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
